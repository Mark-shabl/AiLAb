# ═══════════════════════════════════════════════════════════════
#  AI Lab — пример файла переменных окружения
#  Скопируйте в .env и заполните значения:
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── GPU ────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=all

# ── HuggingFace ───────────────────────────────────────────────
HF_TOKEN=hf_ваш_токен_здесь

# ── Порты сервисов ────────────────────────────────────────────
LF_PORT_UI=7860
LF_PORT_API=8000
TB_PORT=6006
AIM_PORT_UI=43800
AIM_PORT_TRACKING=53800
JUPYTER_PORT=8888
OLLAMA_PORT=11434
# Onyx (отдельный официальный compose) по умолчанию: UI на порту 3000
